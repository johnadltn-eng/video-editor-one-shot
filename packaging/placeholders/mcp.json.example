{
  "_comment": "Portable placeholder for the Premiere-on-macOS starter. This is not a finished machine config and it is not evidence that setup has been run. ./setup-premiere.sh writes .mcp.json on the machine that will edit. Paths are relative to the project root. Telemetry is set off. Do not commit .mcp.json. This starter does not claim Windows, Linux, Resolve, or CapCut support. /tmp/premiere-mcp-bridge is a shared bridge directory, not a home directory.",
  "mcpServers": {
    "premiere-pro": {
      "command": "node",
      "args": ["vendor/premiere-mcp/dist/index.js"],
      "env": {
        "PREMIERE_TEMP_DIR": "/tmp/premiere-mcp-bridge",
        "PREMIERE_TIMEOUT_MS": "60000",
        "PREMIERE_MCP_TELEMETRY": "0"
      }
    }
  }
}
